# Server Configuration
PORT=3000

# Database Configuration (Local Development)
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=accounting_db
MYSQLPORT=3306

# Database Configuration (Railway - Auto-generated, do not set manually)
# MYSQL_URL=mysql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production

# Notes:
# - For Railway deployment, only set JWT_SECRET manually
# - Railway auto-generates MYSQL* variables when you add a MySQL database
# - The app automatically detects and uses DATABASE_URL or MYSQL_URL if available
